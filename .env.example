# SQLite file location (folder is created automatically)
DB_PATH=./data/qoda.db

# Public base URL, used for QR codes and links in emails
APP_URL=http://localhost:3000

# Outgoing email over SMTP. Leave unset to print emails to the terminal instead.
# smtps:// for port 465, smtp:// for 587 (upgrades with STARTTLS). URL-encode special characters in the password.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Qoda <queue@yourdomain.com>"
